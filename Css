:root{--bg:#f5f7f4;--ink:#10231b;--muted:#66736d;--card:#fff;--line:#dfe6e1;--accent:#0c8f5a;--shadow:0 18px 50px #16332612}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:var(--bg)}a{text-decoration:none;color:inherit}.topbar{height:74px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 6%;position:sticky;top:0;z-index:20}.brand{display:flex;align-items:center;gap:10px}.brand-mark{width:42px;height:42px;border-radius:13px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:800}.brand small,.brand b{display:block}.brand small{color:var(--muted);font-size:11px;letter-spacing:2px;text-transform:uppercase}nav{display:flex;gap:22px;align-items:center;font-size:14px}nav a:hover{color:var(--accent)}.btn{border:0;border-radius:12px;padding:12px 18px;font-weight:750;cursor:pointer;display:inline-block}.btn-primary{background:var(--accent);color:#fff}.btn-outline{background:transparent;border:1px solid #b8c6be}.btn-light{background:#eef3f0}.full{width:100%}.hero{min-height:620px;padding:90px 7%;display:grid;grid-template-columns:1.35fr .65fr;gap:60px;align-items:center;background:radial-gradient(circle at 85% 20%,#dff7ea,transparent 30%)}.eyebrow{font-size:12px;letter-spacing:2px;font-weight:850;color:var(--accent)}h1{font-size:clamp(48px,7vw,84px);line-height:.98;margin:18px 0}h1 em{color:var(--accent);font-style:normal}h2{font-size:38px;margin:8px 0 14px}p{color:var(--muted);line-height:1.7}.hero-actions{display:flex;gap:12px;margin:30px 0}.open-pill{display:inline-block;padding:10px 15px;border:1px solid var(--line);border-radius:999px;background:#fff;font-size:13px}.hero-card,.dashboard-card,.info-card,.plans article,.facility-grid article,.contact-card{background:var(--card);border:1px solid var(--line);border-radius:24px;box-shadow:var(--shadow)}.hero-card{padding:34px;text-align:center}.hero-card strong{display:block;font-size:72px;margin:18px 0 0}.hero-card span{color:var(--muted)}.live{font-size:11px;letter-spacing:2px;font-weight:800;color:var(--accent)}.mini-stats{display:grid;grid-template-columns:1fr 1fr;margin-top:30px;border-top:1px solid var(--line);padding-top:20px}.mini-stats b,.mini-stats small{display:block}.mini-stats small{font-size:12px;margin-top:5px}.section{padding:85px 7%}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:30px}.facility-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.facility-grid article{padding:25px}.facility-grid span{font-size:28px}.facility-grid h3{margin-bottom:4px}.dark-section{background:#10231b;color:#fff}.dark-section p,.dark-section .eyebrow{color:#b8cec3}.dark-section h2{color:#fff}.seat-hall{margin-bottom:35px}.seat-hall h3{margin-bottom:16px}.seat-grid{display:grid;grid-template-columns:repeat(10,minmax(42px,1fr));gap:9px}.seat{min-height:55px;border:1px solid #45675a;border-radius:10px;background:#18382c;color:#bfe8d4;cursor:pointer;font-size:11px;font-weight:800}.seat.occupied{background:#8f272c;border-color:#d05b5f;color:#fff}.seat.reserved{background:#765b17;border-color:#d2a931;color:#fff}.seat small{display:block;font-weight:500;margin-top:4px;opacity:.8}.plans{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}.plans article{padding:24px}.plans strong{font-size:34px;display:inline-block;margin:14px 0 5px}.plans span{color:var(--muted)}.plans .btn{margin-top:14px}.locker-note{margin-top:20px}.portal-section{background:#eaf1ed}.portal-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.dashboard-card,.info-card{padding:30px}.dashboard-card{display:grid;grid-template-columns:auto 1fr auto;gap:12px;align-items:center}.avatar{width:55px;height:55px;border-radius:16px;background:var(--ink);color:#fff;display:grid;place-items:center;font-weight:800}.dashboard-card h3,.dashboard-card p{margin:0}.badge{background:#eef2ef;padding:7px 10px;border-radius:99px;font-size:12px}.dash-row{grid-column:1/-1;display:flex;justify-content:space-between;border-top:1px solid var(--line);padding-top:13px;margin-top:3px}.qr-placeholder{width:160px;height:160px;margin:20px auto;background:repeating-linear-gradient(45deg,#111 0 7px,#fff 7px 14px);display:grid;place-items:center;color:transparent}.notices{display:grid;gap:12px}.notice{background:#fff;border:1px solid var(--line);padding:20px;border-radius:16px}.notice b{display:block;margin-bottom:5px}.rules{display:grid;grid-template-columns:1fr .7fr;gap:50px}.rules li{margin:12px 0;color:var(--muted)}.contact-card{padding:30px}.contact-card .btn{margin:6px 6px 0 0}footer{padding:30px 7%;display:flex;gap:30px;justify-content:space-between;background:#0a1812;color:#fff}footer span{color:#aab9b2}.modal{position:fixed;inset:0;background:#07110dcc;display:grid;place-items:center;z-index:50;padding:20px}.hidden{display:none}.modal-box{background:#fff;border-radius:22px;padding:30px;max-width:520px;width:100%;position:relative}.close{position:absolute;right:15px;top:10px;border:0;background:none;font-size:30px;cursor:pointer}@media(max-width:850px){nav a{display:none}.hero{grid-template-columns:1fr;padding-top:60px}.facility-grid,.plans{grid-template-columns:1fr 1fr}.portal-grid,.rules{grid-template-columns:1fr}.seat-grid{grid-template-columns:repeat(5,1fr)}h1{font-size:55px}.section{padding:60px 5%}.topbar{padding:0 5%}footer{flex-direction:column;gap:8px}}@media(max-width:520px){.facility-grid,.plans{grid-template-columns:1fr}.hero-actions{flex-direction:column}.hero-actions .btn{text-align:center}.seat-grid{grid-template-columns:repeat(4,1fr)}.dashboard-card{grid-template-columns:auto 1fr}.dashboard-card .badge{grid-column:1/-1}.hero-card strong{font-size:58px}}
